[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_description }}"
requires-python = ">={{ python_version }}"
dependencies = [
{% if project_type == "fastapi" %}
    "fastapi>=0.115.0",
    "uvicorn[standard]>=0.32.0",
{% elif project_type == "rag" %}
    "fastapi>=0.115.0",
    "uvicorn[standard]>=0.32.0",
    "langchain>=0.3.0",
    "langchain-openai>=0.3.0",
{% elif project_type == "workflow" %}
    "fastapi>=0.115.0",
    "uvicorn[standard]>=0.32.0",
    "langgraph>=0.2.0",
{% elif project_type == "multi-agent" %}
    "fastapi>=0.115.0",
    "uvicorn[standard]>=0.32.0",
    "openai-agents>=0.16.0",
{% endif %}
]

[dependency-groups]
dev = [
{% if project_type != "react" %}
    "bandit>=1.7.0",
    "httpx>=0.27.0",
    "pyright>=1.1.0",
    "pytest>=8.0.0",
    "pytest-cov>=5.0.0",
    "ruff>=0.8.0",
{% endif %}
]

[tool.ruff]
line-length = 100
target-version = "py{{ python_version|replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]

[tool.pyright]
include = ["src", "tests"]
pythonVersion = "{{ python_version }}"
