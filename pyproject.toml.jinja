[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_description }}"
requires-python = ">={{ python_version }}"
dependencies = [
{% if project_type in ["fastapi", "fastapi-react", "rag", "langgraph"] %}
    "fastapi>=0.115.0",
    "uvicorn[standard]>=0.32.0",
{% endif %}
{% if project_type == "langgraph" %}
    "langgraph>=0.2.0",
{% endif %}
]

[dependency-groups]
dev = [
    "bandit>=1.7.0",
    "httpx>=0.27.0",
    "pyright>=1.1.0",
    "pytest>=8.0.0",
    "ruff>=0.8.0",
]

[tool.ruff]
line-length = 100
target-version = "py{{ python_version|replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]

[tool.pyright]
include = ["src", "tests"]
pythonVersion = "{{ python_version }}"
