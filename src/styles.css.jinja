:root {
  color: #17202a;
  background: #f7f8fa;
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
}

.app-shell {
  display: grid;
  min-height: 100vh;
  place-items: center;
  padding: 32px;
}

.app-panel {
  width: min(640px, 100%);
  border: 1px solid #d8dee8;
  border-radius: 8px;
  background: #ffffff;
  padding: 32px;
  box-shadow: 0 16px 40px rgb(23 32 42 / 8%);
}

.eyebrow {
  margin: 0 0 12px;
  color: #4263eb;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0;
  text-transform: uppercase;
}

h1 {
  margin: 0 0 16px;
  font-size: 2rem;
  line-height: 1.15;
}

p {
  margin: 0;
  color: #465568;
  line-height: 1.6;
}
